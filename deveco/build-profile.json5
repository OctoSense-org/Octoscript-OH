{
  "app": {
    // The debug signing passwords are not committed: DevEco fills these in locally
    // (Project Structure > Signing Configs), and the .p12/.cer/.p7b stay in ~/.ohos.
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "~/.ohos/config/default_MyApplication_IyDNmV-wdKmfp3kaG7cXlzSz0gcU1_EEDqo9b2P37I8=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "",
          "profile": "~/.ohos/config/default_MyApplication_IyDNmV-wdKmfp3kaG7cXlzSz0gcU1_EEDqo9b2P37I8=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "~/.ohos/config/default_MyApplication_IyDNmV-wdKmfp3kaG7cXlzSz0gcU1_EEDqo9b2P37I8=.p12",
          "storePassword": ""
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.0.1(21)",
        "runtimeOS": "HarmonyOS",
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "octoscript_oh",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
